{
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "cd frontend && bun run test",
    "test:run": "cd frontend && bun run test:run",
    "test:backend": "cd backend && bun test",
    "deploy:frontend": "cd app/web-frontend && bun run build && bunx wrangler pages deploy dist/ --project-name=nuxipro-cloud --branch=main"
  },
  "name": "center",
  "private": true,
  "workspaces": [
    "app/backend",
    "app/web-frontend",
    "packages/*"
  ],
  "dependencies": {
    "@biomejs/biome": "^2.6.6",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "knip": "^6.44.2",
    "typescript": "^7.0.2"
  }
}
