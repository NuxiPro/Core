{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "app/web-frontend/**/*.{ts,tsx,js,jsx,css,html}",
      "app/backend/**/*.ts",
      "app/lauding-page/**/*.{ts,tsx,js,jsx,css,html}",
      "!app/web-frontend/routeTree.gen.ts",
      "!app/lauding-page/**/routeTree.gen.ts",
      "!app/lauding-page/dist",
      "!app/lauding-page/node_modules",
      "!app/web-frontend/dist",
      "!app/web-frontend/node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noForEach": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "warn",
        "useSelfClosingElements": "warn"
      },
      "suspicious": {
        "noConsole": "warn",
        "noDebugger": "error",
        "noArrayIndexKey": "warn",
        "noDoubleEquals": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "app/web-frontend/src/components/tiptap-ui/**",
        "app/web-frontend/src/components/tiptap-ui-primitive/**",
        "app/web-frontend/src/components/tiptap-node/**",
        "app/web-frontend/src/components/tiptap-icons/**",
        "app/web-frontend/src/hooks/**",
        "app/web-frontend/src/lib/tiptap-utils.ts"
      ],
      "linter": {
        "rules": { "recommended": false }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      "includes": ["**/kanban-demo.html"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ]
}
